# Backend Environment Variables (copy to .env)

PORT=5000
NODE_ENV=development

# MongoDB connection string (MONGODB_URI is also accepted)
MONGO_URI=mongodb://127.0.0.1:27017/coursemaster

# Secret used to sign JWTs - use a long random string
JWT_SECRET=replace_with_a_long_random_secret

# Key required to register an admin account from the Register page
ADMIN_REGISTRATION_KEY=replace_with_admin_key

# Used in welcome email links
FRONTEND_URL=http://localhost:5173

# Optional: welcome email (skipped when not set)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: seeded admin email (npm run seed)
ADMIN_EMAIL=admin@coursemaster.com
